# Токен Telegram-бота от @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram ID администратора (или нескольких через запятую, например: 123456789,987654321)
ADMIN_CHAT_ID=123456789

# Подключение к PostgreSQL на сервере
DB_HOST=postgres
DB_PORT=5432
DB_NAME=eva_art_db
DB_USER=eva_user
DB_PASSWORD=super_secure_password_here

# Публичный URL Telegram Mini App (HTTPS обязателен для Telegram WebApp)
# Например: https://eva-art42.ru или https://subdomain.yourserver.aeza.network
WEBAPP_URL=https://eva-art42.ru

# Порт веб-приложения (FastAPI) внутри сервера/контейнера
APP_PORT=8030
APP_HOST=0.0.0.0
